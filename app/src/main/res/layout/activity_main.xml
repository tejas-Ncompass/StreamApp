    <FrameLayout
        android:id="@+id/preview_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <com.pedro.library.view.OpenGlView
            android:id="@+id/capture_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:aspectRatioMode="fill"/>

    <ImageView
        android:id="@+id/live_status"
        android:layout_width="@dimen/value_50dp"
        android:layout_height="@dimen/value_20dp"
        android:src="@drawable/live"
        android:layout_marginTop="@dimen/value_24dp"
        android:layout_marginStart="@dimen/value_20dp"
        android:visibility="invisible" />
    <ProgressBar
        android:id="@+id/loading_spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/online_status"
        android:layout_width="@dimen/value_30dp"
        android:layout_height="@dimen/value_30dp"
        android:src="@drawable/online"
        android:layout_marginTop="@dimen/value_30dp"
        android:layout_marginEnd="@dimen/value_120dp"
        android:layout_gravity="top|right"
        android:visibility="invisible"/>

    <ImageView
        android:id="@+id/offline_status"
        android:layout_width="@dimen/value_30dp"
        android:layout_height="@dimen/value_30dp"
        android:src="@drawable/offline"
        android:layout_marginTop="@dimen/value_30dp"
        android:layout_marginEnd="@dimen/value_120dp"
        android:layout_gravity="top|right"
        android:visibility="invisible"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom|center">
        <Button
            android:id="@+id/btn_start_stop"
            android:layout_width="@dimen/value_145dp"
            android:layout_height="@dimen/value_66dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/value_3dp"
            android:padding="@dimen/value_15dp"
            android:text="@string/go_live"
            android:textColor="@color/white"
            android:backgroundTint="@color/green"
            android:layout_marginRight="@dimen/value_5dp"
            android:textSize="@dimen/value_22dp"
            android:drawableLeft="@drawable/ic_play"
            android:layout_gravity="center|bottom"
            app:cornerRadius="@dimen/value_15dp"/>

        <Button
            android:id="@+id/stop_button"
            android:layout_width="@dimen/value_145dp"
            android:layout_height="@dimen/value_66dp"
            android:layout_marginBottom="@dimen/value_3dp"
            android:layout_marginLeft="@dimen/value_5dp"
            android:paddingStart="@dimen/value_20dp"
            android:text="@string/stop"
            android:textColor="@color/white"
            android:textSize="@dimen/value_22dp"
            android:backgroundTint="@color/red"
            android:layout_gravity="center|bottom"
            android:drawableLeft="@drawable/stop_btn"
            app:cornerRadius="@dimen/value_15dp"
            android:visibility="gone"/>

    </LinearLayout>
        <LinearLayout
            android:id="@+id/baked_view"
            android:layout_width="@dimen/value_155dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="top|right"
            android:layout_marginEnd="@dimen/value_160dp"
            android:layout_marginTop="@dimen/value_30dp"
            android:visibility="invisible"  >

            <TextView
                android:id="@+id/mbps1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/value_15dp"
                android:textColor="@color/white"
                android:layout_marginStart="@dimen/value_20dp"
                android:layout_marginBottom="@dimen/value_25dp"/>

            <ImageView
                android:id="@+id/signal_strength1"
                android:layout_width="@dimen/value_20dp"
                android:layout_height="@dimen/value_20dp"
                android:layout_marginStart="@dimen/value_10dp"
                android:layout_marginBottom="@dimen/value_25dp"/>

            <ImageView
                android:id="@+id/quality_image"
                android:layout_width="@dimen/value_30dp"
                android:layout_height="@dimen/value_25dp"
                android:src="@drawable/q3"
                android:layout_marginStart="@dimen/value_10dp"
                android:layout_marginBottom="@dimen/value_25dp"/>

            <ImageView
                android:id="@+id/mute_image"
                android:layout_width="@dimen/value_30dp"
                android:layout_height="@dimen/value_25dp"
                android:src="@drawable/no_sound"
                android:layout_marginStart="@dimen/value_10dp"
                android:layout_marginBottom="@dimen/value_25dp"
                android:visibility="gone"/>

        </LinearLayout>

        <Button
            android:id="@+id/open_scoreboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open"
            android:layout_gravity="bottom|left"
            android:layout_marginStart="@dimen/value_10dp"
            android:layout_marginBottom="@dimen/value_15dp"
            android:backgroundTint="@color/black"
            app:cornerRadius="@dimen/value_10dp"
            android:textColor="@color/white"/>


    </FrameLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
         android:gravity="top|right">

        <ImageButton
            android:id="@+id/quality_button"
            android:layout_width="@dimen/value_50dp"
            android:layout_height="@dimen/value_50dp"
           android:layout_marginTop="@dimen/value_30dp"
            android:layout_marginEnd="@dimen/value_50dp"
            android:background="@drawable/round_button"
            android:backgroundTint="@color/white"
            android:src="@drawable/settings"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/right_drawer"
        android:layout_width="@dimen/value_500dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="20dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="@dimen/value_60dp">

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginEnd="@dimen/value_34dp"
           android:orientation="horizontal">

           <androidx.cardview.widget.CardView
               android:id="@+id/mic_card"
               android:layout_width="0dp"
               android:layout_height="@dimen/value_100dp"
               android:layout_weight="1"
               android:backgroundTint="@color/card_color"
               app:cardCornerRadius="@dimen/value_10dp"
               android:layout_marginTop="@dimen/value_10dp"
