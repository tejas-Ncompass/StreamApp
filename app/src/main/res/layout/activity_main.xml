<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".MainActivity">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scoreboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tma_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="@dimen/value_50dp"
            app:layout_constraintBottom_toTopOf="@+id/tma"
            app:layout_constraintEnd_toEndOf="@+id/tma"
            app:layout_constraintStart_toStartOf="@+id/tma" />

        <TextView
            android:id="@+id/tma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:text="PL1"
            android:textColor="@color/white"
            android:textSize="@dimen/value_12dp"
            app:layout_constraintBottom_toTopOf="@+id/teamA_plus"
            app:layout_constraintEnd_toEndOf="@+id/teamA_plus"
            app:layout_constraintStart_toStartOf="@+id/teamA_plus" />

        <ImageButton
            android:id="@+id/teamA_plus"
            android:layout_width="@dimen/value_80dp"
            android:layout_height="@dimen/value_130dp"
            android:layout_marginStart="15dp"
            android:background="@drawable/plus_button"
            android:drawableTint="@color/white"
            android:src="@drawable/plus"
            app:layout_constraintBottom_toTopOf="@+id/teamA_minus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0" />

        <View
            android:id="@+id/view"
            android:layout_width="@dimen/value_80dp"
            android:layout_height="@dimen/value_2dp"
            android:background="@color/grey"
            app:layout_constraintBottom_toBottomOf="@+id/teamA_plus"
            app:layout_constraintEnd_toEndOf="@+id/teamA_plus"
            app:layout_constraintStart_toStartOf="@+id/teamA_plus"
            app:layout_constraintTop_toBottomOf="@+id/teamA_plus" />

        <ImageButton
            android:id="@+id/teamA_minus"
            android:layout_width="@dimen/value_80dp"
            android:layout_height="@dimen/value_55dp"
            android:layout_marginStart="15dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/minus_button"
            android:src="@drawable/minus"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <TextView
            android:id="@+id/tmb_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="@dimen/value_50dp"
            app:layout_constraintBottom_toTopOf="@+id/tmb"
            app:layout_constraintEnd_toEndOf="@+id/tmb"
            app:layout_constraintStart_toStartOf="@+id/tmb" />

        <TextView
            android:id="@+id/tmb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:layout_marginEnd="@dimen/value_10dp"
            android:text="PL2"
            android:textColor="@color/white"
            android:textSize="@dimen/value_12dp"
            app:layout_constraintBottom_toTopOf="@+id/teamB_plus"
            app:layout_constraintEnd_toEndOf="@+id/teamB_plus"
            app:layout_constraintStart_toStartOf="@+id/teamB_plus" />

        <ImageButton
            android:id="@+id/teamB_plus"
            android:layout_width="@dimen/value_80dp"
            android:layout_height="@dimen/value_130dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/plus_button"
            android:drawableTint="@color/white"
            android:src="@drawable/plus"
            app:layout_constraintBottom_toTopOf="@+id/teamB_minus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0" />

        <View
            android:layout_width="@dimen/value_80dp"
            android:layout_height="@dimen/value_2dp"
            android:background="@color/grey"
            app:layout_constraintBottom_toBottomOf="@+id/teamB_plus"
            app:layout_constraintEnd_toEndOf="@+id/teamB_plus"
            app:layout_constraintStart_toStartOf="@+id/teamB_plus"
            app:layout_constraintTop_toBottomOf="@+id/teamB_plus" />

        <ImageButton
            android:id="@+id/teamB_minus"
            android:layout_width="@dimen/value_80dp"
            android:layout_height="@dimen/value_55dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/minus_button"
            android:src="@drawable/minus"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/bottom_soreboard_layout"
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/bg_set_box">

                <LinearLayout
                    android:layout_width="@dimen/value_100dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/playerA_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:text="Player 1"
                        android:textColor="@color/white"
                        android:textSize="16sp"/>

                    <ImageView
                        android:id="@+id/plA_serve"
                        android:layout_width="@dimen/value_30dp"
                        android:layout_height="@dimen/value_30dp"
                        android:src="@drawable/green_arrow"/>

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/black"/>

                <LinearLayout
                    android:layout_width="@dimen/value_100dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/playerB_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:text="Player 2"
                        android:textColor="@color/white"
                        android:textSize="16sp" />
                    <ImageView
                        android:id="@+id/plB_serve"
                        android:layout_width="@dimen/value_30dp"
                        android:layout_height="@dimen/value_30dp"
                        android:src="@drawable/grey_arrow"/>
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/set1_card"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:orientation="vertical"
                android:background="@drawable/bg_set_box">

                <TextView
                    android:id="@+id/set1A"
                    android:layout_width="match_parent"
